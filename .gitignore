# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/
.eggs/

# --- Virtual environments ---
.venv/
venv/
env/

# --- Model weights / checkpoints (3G+ CLIP ViT-L weights live in checkpoints/) ---
checkpoints/
*.pt
*.pth
*.ckpt
*.safetensors
*.bin

# --- Experiment outputs (per-run JSONs, visualizations, reports) ---
results/
runs/
outputs/
wandb/

